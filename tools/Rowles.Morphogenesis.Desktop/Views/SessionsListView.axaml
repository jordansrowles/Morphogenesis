<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Rowles.Morphogenesis.Desktop.Views.SessionsListView">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <TextBlock Grid.Row="0" Text="{Binding Status}" />
    <ListBox Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" Spacing="14" Margin="8">
            <TextBlock Text="{Binding ExperimentId}" Width="180" />
            <TextBlock Text="{Binding ReplicateId}" Width="170" />
            <TextBlock Text="{Binding Status}" Width="100" />
            <TextBlock Text="{Binding CurrentMcs}" Width="90" />
            <TextBlock Text="{Binding RecordingState}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Button Grid.Row="2" Content="Open selected session" Command="{Binding OpenSessionCommand}" HorizontalAlignment="Left" />
  </Grid>
</UserControl>
