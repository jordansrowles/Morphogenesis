<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Rowles.Morphogenesis.Desktop.ViewModels"
        xmlns:views="using:Rowles.Morphogenesis.Desktop.Views"
        x:Class="Rowles.Morphogenesis.Desktop.Views.MainWindow"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Title="Rowles Morphogenesis Laboratory">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:ExperimentListViewModel}">
      <views:ExperimentListView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SessionsListViewModel}">
      <views:SessionsListView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SessionViewModel}">
      <views:SessionView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RecordingPlaybackViewModel}">
      <views:RecordingPlaybackView />
    </DataTemplate>
  </Window.DataTemplates>
  <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
    <DockPanel Grid.Row="0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
        <Button Content="Experiments" Command="{Binding ShowExperimentsCommand}" />
        <Button Content="Sessions" Command="{Binding ShowSessionsCommand}" />
      </StackPanel>
      <TextBlock DockPanel.Dock="Right"
                 VerticalAlignment="Center"
                 Foreground="DarkOrange"
                 Text="{Binding NetworkWarning}" />
      <TextBox Text="{Binding ServerBaseUri, UpdateSourceTrigger=LostFocus}"
                 PlaceholderText="Server base URI"
               MinWidth="300"
               HorizontalAlignment="Right" />
    </DockPanel>
    <Border Grid.Row="1" BorderThickness="1" BorderBrush="#607080" CornerRadius="4" Padding="12">
      <ContentControl Content="{Binding CurrentContent}" />
    </Border>
  </Grid>
</Window>
