<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Rowles.Morphogenesis.Desktop.Views.ExperimentListView">
  <Grid ColumnDefinitions="*,360" RowDefinitions="Auto,*" ColumnSpacing="18" RowSpacing="12">
    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Status}" />
    <ListBox Grid.Row="1" ItemsSource="{Binding Experiments}" SelectedItem="{Binding SelectedExperiment}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="12" Margin="0,0,0,8" BorderBrush="#536272" BorderThickness="1" CornerRadius="4">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ExperimentId}" />
              <TextBlock Text="{Binding GridWidth, StringFormat='Width: {0}'}" />
              <TextBlock Text="{Binding GridHeight, StringFormat='Height: {0}'}" />
              <TextBlock Text="{Binding McsCount, StringFormat='MCS: {0}'}" />
              <TextBlock Text="{Binding BoundaryMode, StringFormat='Boundary: {0}'}" />
              <TextBlock Text="{Binding CellTypeNames}" Opacity="0.75" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="1" Grid.Column="1" Padding="18" BorderBrush="#536272" BorderThickness="1" CornerRadius="4">
      <StackPanel Spacing="12">
        <TextBlock Text="Create a remote session" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Experiment" />
        <ComboBox ItemsSource="{Binding Experiments}" SelectedItem="{Binding SelectedExperiment}" MinWidth="280">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Replicate index" />
        <NumericUpDown Value="{Binding ReplicateIndex}" Minimum="0" Increment="1" FormatString="0" />
        <TextBlock Text="Live frame rate (FPS)" />
        <NumericUpDown Value="{Binding LiveFps}" Minimum="1" Maximum="60" Increment="1" FormatString="0" />
        <CheckBox Content="Record this session" IsChecked="{Binding RecordingEnabled}" />
        <Button Content="Create session" Command="{Binding CreateSessionCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
